# ==============================================================================
# Project 4 — Orient BlackSwan History Bot Environment Configuration
# ==============================================================================

# Google Gemini API Key
# 1. Get a free API key at: https://aistudio.google.com/
# 2. Rename this file to .env: cp .env.example .env
# 3. Paste your API key below:
GOOGLE_API_KEY=your_gemini_api_key_here

# Embedding Configuration
# Local HuggingFace embeddings (runs locally, no API limits or quotas)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chat Model Configuration
# Low temperature (0.0) ensures deterministic and factual grounded answers
LLM_MODEL=gemini-2.5-flash
TEMPERATURE=0.0

# Document & ChromaDB Settings
PDF_PATH=data/History_2024-25.pdf
CHROMA_DIR=chroma_db
COLLECTION_NAME=history_rag
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
